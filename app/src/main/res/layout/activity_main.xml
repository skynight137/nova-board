<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
<ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
     android:padding="@dimen/nb_space_6">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
         android:layout_marginTop="@dimen/nb_space_4"
         android:layout_marginBottom="@dimen/nb_space_6"
        android:text="@string/app_name"
         android:textSize="24sp"
         android:textColor="@color/kb_key_text"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnEnable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
         android:layout_marginBottom="@dimen/nb_space_4"
        android:text="@string/enable_keyboard" />

    <Button
        android:id="@+id/btnSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
         android:layout_marginBottom="@dimen/nb_space_7"
        android:text="@string/switch_keyboard" />

    <Button
        android:id="@+id/btnExportLog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
         android:layout_marginBottom="@dimen/nb_space_6"
        android:text="@string/export_app_log" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/keyboard_preferences"
        android:textStyle="bold"
         android:layout_marginBottom="@dimen/nb_space_4"
         android:textSize="16sp"
         android:textColor="@color/kb_key_text" />

    <Button
        android:id="@+id/btnLayoutSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="@string/layout_keys" />

    <Button
        android:id="@+id/btnTypingSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="@string/typing" />

    <Button
        android:id="@+id/btnEmojiSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="@string/emoji" />

    <Button
        android:id="@+id/btnSoundSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/sound_vibration" />

    <Button
        android:id="@+id/btnGestureSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="@string/gesture_input" />

    <Button
        android:id="@+id/btnIncognito"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/incognito_mode" />

    <Button
        android:id="@+id/btnResetSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/reset_settings" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/theme_label"
        android:textStyle="bold"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp" />

    <RadioGroup
        android:id="@+id/themeGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RadioButton android:id="@+id/radioSystem" android:text="@string/theme_system" />
        <RadioButton android:id="@+id/radioLight" android:text="@string/theme_light" />
        <RadioButton android:id="@+id/radioDark" android:text="@string/theme_dark" />
    </RadioGroup>

</LinearLayout>
</ScrollView>
<Button
    android:id="@+id/btnLayoutPreview"
    android:layout_width="64dp"
    android:layout_height="64dp"
    android:layout_gravity="bottom|end"
    android:layout_margin="16dp"
    android:contentDescription="@string/layout_preview"
    android:text="⌨"
    android:textSize="24sp"
    android:backgroundTint="@color/kb_accent" />
</FrameLayout>

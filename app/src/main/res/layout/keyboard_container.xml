<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
     android:layout_height="wrap_content"
    android:background="@color/kb_background">

    <LinearLayout
        android:id="@+id/keyboardRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <TextView
        android:id="@+id/incognitoBanner"
        android:layout_width="match_parent"
         android:layout_height="@dimen/nb_toolbar_height"
        android:background="@color/kb_incognito_background"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/incognito_on"
        android:textColor="@color/kb_incognito_text"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Tools row expands above the always-visible prediction row. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/toolsBar"
            android:layout_width="match_parent"
             android:layout_height="@dimen/nb_toolbar_height"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:visibility="gone">

            <ImageButton android:id="@+id/btnClipboard" style="@style/NovaBoardToolIcon"
                android:src="@drawable/ic_clipboard" android:contentDescription="@string/cd_clipboard" />
            <ImageButton android:id="@+id/btnHotkeys" style="@style/NovaBoardToolIcon"
                android:src="@drawable/ic_hotkeys" android:contentDescription="@string/cd_hotkeys" />
            <ImageButton android:id="@+id/btnVoice" style="@style/NovaBoardToolIcon"
                android:src="@drawable/ic_mic" android:contentDescription="@string/cd_voice" />
            <TextView android:id="@+id/btnGif" style="@style/NovaBoardToolText"
                android:text="GIF" android:contentDescription="@string/cd_gif" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/suggestionBar"
            android:layout_width="match_parent"
             android:layout_height="@dimen/nb_toolbar_height"
            android:orientation="horizontal"
            android:visibility="visible">

            <ImageButton android:id="@+id/btnToggleStripFromSuggestions" style="@style/NovaBoardToolIcon"
                android:layout_width="40dp"
                android:src="@drawable/ic_chevron_up" android:contentDescription="@string/cd_expand_tools" />

            <TextView android:id="@+id/suggestion1" style="@style/NovaBoardSuggestion" />
            <TextView android:id="@+id/suggestion2" style="@style/NovaBoardSuggestionHighlighted" />
            <TextView android:id="@+id/suggestion3" style="@style/NovaBoardSuggestion" />
            <ImageButton android:id="@+id/btnMore" style="@style/NovaBoardToolIcon"
                android:src="@drawable/ic_more" android:contentDescription="@string/cd_more" />
        </LinearLayout>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/kb_divider" />

    <!-- Collapsible hotkeys row: ESC / TAB / CTRL / ALT / nav, for external-keyboard-style input -->
    <HorizontalScrollView
        android:id="@+id/hotkeysScroller"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:visibility="gone"
        android:scrollbars="none">
        <LinearLayout
            android:id="@+id/hotkeysRow"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp" />
    </HorizontalScrollView>

    <!-- Custom-drawn number row + QWERTY + bottom row (see KeyboardView.kt) -->
    <com.novaboard.ime.view.KeyboardView
        android:id="@+id/keyboardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- Row 5: cursor / navigation arrows -->
    <LinearLayout
        android:id="@+id/cursorRow"
        android:layout_width="match_parent"
         android:layout_height="@dimen/nb_cursor_row_height"
        android:orientation="horizontal"
        android:gravity="center">

        <ImageButton
            android:id="@+id/btnCursorUp"
            style="@style/NovaBoardCursorArrow"
            android:src="@drawable/ic_arrow_up"
            android:contentDescription="@string/cd_cursor_up" />
        <ImageButton
            android:id="@+id/btnCursorDown"
            style="@style/NovaBoardCursorArrow"
            android:src="@drawable/ic_arrow_down"
            android:contentDescription="@string/cd_cursor_down" />
        <ImageButton
            android:id="@+id/btnCursorLeft"
            style="@style/NovaBoardCursorArrow"
            android:src="@drawable/ic_arrow_left"
            android:contentDescription="@string/cd_cursor_left" />
        <ImageButton
            android:id="@+id/btnCursorRight"
            style="@style/NovaBoardCursorArrow"
            android:src="@drawable/ic_arrow_right"
            android:contentDescription="@string/cd_cursor_right" />
    </LinearLayout>

    </LinearLayout>

    <FrameLayout
        android:id="@+id/emojiPanelContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/overlayPanelContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/kb_background"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />
</FrameLayout>

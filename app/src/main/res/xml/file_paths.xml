<?xml version="1.0" encoding="utf-8"?>
<!--
    Exposes only two app-private directories via the FileProvider declared
    in AndroidManifest.xml — nothing else under app-private storage is
    shared:
     - logs/    — app/src/main/java/com/auroraeq/app/util/AppLog.kt
    - exports/ — per-preset "Share" files written by PresetsScreen.kt; "Export all"
                 goes through Storage Access Framework instead, so it never
                 touches this directory.
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <files-path name="logs" path="logs/" />
    <files-path name="exports" path="exports/" />
</paths>

<resources>
    <style name="NovaBoardToolIcon">
        <item name="android:layout_width">@dimen/nb_touch_target_min</item>
        <item name="android:layout_height">@dimen/nb_touch_target_min</item>
        <item name="android:minWidth">@dimen/nb_touch_target_min</item>
        <item name="android:minHeight">@dimen/nb_touch_target_min</item>
        <item name="android:layout_margin">0dp</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:padding">@dimen/nb_space_4</item>
        <item name="android:tint">@color/kb_toolbar_icon</item>
    </style>

    <style name="NovaBoardSuggestion">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/kb_suggestion_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="NovaBoardSuggestionHighlighted" parent="NovaBoardSuggestion">
        <item name="android:textColor">@color/kb_suggestion_text_highlight</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="NovaBoardCursorArrow">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/nb_cursor_row_height</item>
        <item name="android:minHeight">@dimen/nb_touch_target_min</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:padding">@dimen/nb_space_4</item>
        <item name="android:tint">@color/kb_toolbar_icon</item>
    </style>

    <style name="NovaBoardHotkey">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:background">@drawable/bg_key_special</item>
        <item name="android:textColor">@color/kb_key_text</item>
        <item name="android:textSize">@dimen/nb_utility_label</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="NovaBoardSettingsPrimaryButton">
        <item name="android:layout_height">56dp</item>
        <item name="android:minHeight">@dimen/nb_settings_row_min_height</item>
        <item name="android:background">@drawable/bg_settings_primary</item>
        <item name="android:textColor">@color/kb_on_accent</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:paddingStart">@dimen/nb_space_6</item>
        <item name="android:paddingEnd">@dimen/nb_space_6</item>
    </style>

    <style name="NovaBoardSettingsRow">
        <item name="android:layout_height">56dp</item>
        <item name="android:minHeight">@dimen/nb_settings_row_min_height</item>
        <item name="android:background">@drawable/bg_settings_row</item>
        <item name="android:textColor">@color/kb_key_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:paddingStart">@dimen/nb_space_6</item>
        <item name="android:paddingEnd">@dimen/nb_space_6</item>
    </style>

    <style name="NovaBoardSettingsReset" parent="NovaBoardSettingsRow">
        <item name="android:background">@drawable/bg_settings_reset</item>
        <item name="android:textColor">@color/kb_danger</item>
    </style>
</resources>

modules = ["nodejs-24", "python-base-3.13"]

[nix]
channel = "stable-25_05"
packages = ["gnupg", "rsync"]

[agent]
expertMode = true

[workflows]
runButton = "Setup Project"

[[workflows.workflow]]
name = "Push (dev)"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "git push origin dev"

[[workflows.workflow]]
name = "Setup Project"
mode = "sequential"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/setup.sh"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Pull (dev) - rebase continue"
mode = "sequential"
author = 45095703

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "git pull origin dev --rebase continue"

[[workflows.workflow]]
name = "Opencode"
mode = "sequential"
author = 47571172

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "if ! source .local/env.sh 2>/dev/null || ! command -v opencode >/dev/null 2>&1; then bash scripts/setup.sh --oc && source .local/env.sh; fi; exec opencode web --port 8000"

[[workflows.workflow]]
name = "Setup Android Tools"
mode = "sequential"
author = 47591184

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/setup.sh --android-tools"

[[workflows.workflow]]
name = "React Native Preview"
mode = "sequential"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run preview:rn"

[workflows.workflow.metadata]
outputType = "webview"

[userenv.shared]
NODE_ENV = "production"
YARN_REGISTRY = "https://registry.yarnpkg.com/"
YARN_NPM_REGISTRY_SERVER = "https://registry.yarnpkg.com/"
PIP_INDEX_URL = "https://pypi.org/simple/"
npm_config_registry = "https://registry.npmjs.org/"
GOPROXY = "https://proxy.golang.org,direct"
PIP_TRUSTED_HOST = "pypi.org"
UV_PYTHON_PREFERENCE = "managed"
UV_PYTHON_DOWNLOADS = "auto"
UV_PROJECT_ENVIRONMENT = ".venv"

[[ports]]
localPort = 80
externalPort = 80
exposeLocalhost = true

[[ports]]
localPort = 5173
externalPort = 5173

[[ports]]
localPort = 5174
externalPort = 3000

[[ports]]
localPort = 5175
externalPort = 3001

[[ports]]
localPort = 8000
externalPort = 8000
exposeLocalhost = true

[[ports]]
localPort = 8080
externalPort = 8080
